#!/usr/bin/env bash
# SEC-83: local secret scan. Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks / apt install gitleaks); skipping secret scan" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
