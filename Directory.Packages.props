<Project>
  <!-- NFR-08: central package management. Every version is pinned; every licence is permissive.
       Runtime packages track the .NET 10 LTS servicing line (10.0.x) to match the shared framework. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <!-- MIT --><PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <!-- MIT --><PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- MIT --><PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <!-- MIT --><PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <!-- Apache-2.0 --><PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Apache-2.0 --><PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- MIT --><PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <!-- MIT; M7 backup schedules (9.1) --><PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- MIT; M8 AI API key at rest (SEC-45), same key ring as the web app --><PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.15" />
    <!-- BSD-2-Clause --><PackageVersion Include="Markdig" Version="1.6.0" />
    <!-- MIT (AngleSharp: MIT) --><PackageVersion Include="HtmlSanitizer" Version="11.0.26" />
    <!-- MIT; M4 HTML import (ADR 0024) --><PackageVersion Include="AngleSharp" Version="1.10.5" />
    <!-- MIT; M4 .docx import --><PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Apache-2.0; M4 PDF text import --><PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- MIT; M4 images (D-11, ADR 0022) --><PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <!-- MIT; Skia native library for linux-x64, no OS packages needed --><PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <!-- MIT --><PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Apache-2.0 --><PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- BSD-3-Clause --><PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- BSD-3-Clause --><PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- MIT --><PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- MIT --><PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <!-- MIT --><PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
  </ItemGroup>
</Project>
