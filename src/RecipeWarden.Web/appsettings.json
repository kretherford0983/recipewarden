{
  "Data": {
    "Directory": "/var/lib/recipewarden"
  },
  "Network": {
    "TrustedProxies": [ "127.0.0.1", "::1" ],
    "AllowedSourceIps": []
  },
  "Backup": {
    "AllowedFolders": [ "/var/lib/recipewarden/backups" ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:5080" }
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
