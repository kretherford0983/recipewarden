@model RecipeWarden.Web.Pages.Listing.RecipeListPageModel
@using RecipeWarden.Core.Search
@* FR-SRCH-02 filters and the results grid, shared by browse, search, tag and collection pages. *@
<form class="filters" method="get" action="@Model.ListPath" aria-label="Filter recipes">
    @if (Model.ListPath == "/search")
    {
        <div class="filter">
            <label for="q">Search</label>
            <input id="q" name="q" type="search" value="@Model.Q" maxlength="@FtsQuery.MaxInputLength">
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Q))
    {
        <input type="hidden" name="q" value="@Model.Q">
    }
    @if (Model.AllTags.Count > 0 && !Model.ListPath.StartsWith("/tags/", StringComparison.Ordinal))
    {
        <div class="filter">
        <label for="tag">Tag</label>
        <select id="tag" name="tag">
            <option value="">Any tag</option>
            @foreach (var t in Model.AllTags)
            {
                <option value="@t.Slug" selected="@(Model.Criteria.TagSlugs.Contains(t.Slug))">@t.Name (@t.RecipeCount)</option>
            }
        </select>
        </div>
    }
    @if (Model.AllCollections.Count > 0 && !Model.ListPath.StartsWith("/collections/", StringComparison.Ordinal))
    {
        <div class="filter">
        <label for="collection">Collection</label>
        <select id="collection" name="collection">
            <option value="">Any collection</option>
            @foreach (var c in Model.AllCollections)
            {
                <option value="@c.Slug" selected="@(Model.Criteria.CollectionSlug == c.Slug)">@c.Name</option>
            }
        </select>
        </div>
    }
    <div class="filter">
    <label for="time">Ready in</label>
    <select id="time" name="time">
        <option value="">Any time</option>
        @foreach (var m in new[] { 15, 30, 45, 60, 90, 120 })
        {
            <option value="@m" selected="@(Model.Criteria.MaxTotalMinutes == m)">@m min or less</option>
        }
    </select>
    </div>
    <div class="filter">
    <label for="sort">Sort</label>
    <select id="sort" name="sort">
        @if (!Model.Criteria.Query.IsEmpty)
        {
            <option value="relevance" selected="@(Model.Criteria.Sort == SearchSort.Relevance)">Best match</option>
        }
        <option value="newest" selected="@(Model.Criteria.Sort == SearchSort.Newest)">Newest</option>
        <option value="title" selected="@(Model.Criteria.Sort == SearchSort.Title)">Title</option>
        <option value="lastcooked" selected="@(Model.Criteria.Sort == SearchSort.LastCooked)">Last cooked</option>
    </select>
    </div>
    <label class="inline"><input type="checkbox" name="image" value="1" checked="@Model.Criteria.HasImage"> With a photo</label>
    <button type="submit" class="primary">Apply</button>
    <details class="free-of" open="@(Model.Criteria.FreeOf.Count > 0)">
        @* BR-53, ADR 0036 *@
        <summary>Free of@(Model.Criteria.FreeOf.Count > 0 ? " (" + Model.Criteria.FreeOf.Count + ")" : "")</summary>
        @foreach (var code in RecipeWarden.Core.Nutrition.AllergenRules.All)
        {
            <label class="inline"><input type="checkbox" name="free" value="@RecipeWarden.Core.Search.SearchCriteria.AllergenQuery(code)" checked="@Model.Criteria.FreeOf.Contains(code)"> @RecipeWarden.Core.Nutrition.AllergenRules.Label(code)</label>
        }
        <label class="inline"><input type="checkbox" name="unverified" value="1" checked="@Model.Criteria.IncludeUnverified"> Include recipes with unmatched ingredients</label>
        <p class="hint">Allergens are estimated from ingredient names; check labels.</p>
    </details>
    @if (Model.ShowingDrafts)
    {
        <input type="hidden" name="status" value="draft">
    }
</form>

<p class="result-count" role="status">
    @if (Model.ShowingDrafts) { <span class="badge">Drafts</span> }
    @Model.Results.Total @(Model.Results.Total == 1 ? "recipe" : "recipes")
    @if (!Model.Criteria.Query.IsEmpty) { <text>for “@Model.Q”</text> }
</p>

@if (Model.Results.Items.Count == 0)
{
    <section class="empty-state">
        <p>No recipes match. Try fewer words or remove a filter.</p>
        @if (Model.CanEdit)
        {
            <p><a class="button-link" href="/manage/recipes/new">Add a recipe</a></p>
        }
    </section>
}
else
{
    <ul class="recipe-grid">
        @foreach (var r in Model.Results.Items)
        {
            <partial name="_RecipeCard" model="@((r, 2))" />
        }
    </ul>
    @if (Model.Results.PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (Model.Results.Page > 1)
            {
                <a href="@Model.LinkWith("page", (Model.Results.Page - 1).ToString(System.Globalization.CultureInfo.InvariantCulture))" rel="prev">Previous</a>
            }
            <span>Page @Model.Results.Page of @Model.Results.PageCount</span>
            @if (Model.Results.Page < Model.Results.PageCount)
            {
                <a href="@Model.LinkWith("page", (Model.Results.Page + 1).ToString(System.Globalization.CultureInfo.InvariantCulture))" rel="next">Next</a>
            }
        </nav>
    }
}
