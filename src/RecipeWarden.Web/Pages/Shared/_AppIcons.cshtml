@* UX-15, ADR 0060: the tab icon, the Apple touch icon, and the manifest that makes the site installable as an app. *@
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="@RecipeWarden.Core.Presentation.AppManifest.ThemeColorLight" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="@RecipeWarden.Core.Presentation.AppManifest.ThemeColorDark" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
