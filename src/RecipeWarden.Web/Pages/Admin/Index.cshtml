@page
@model RecipeWarden.Web.Pages.Admin.IndexModel
@using RecipeWarden.Core.Health
@using RecipeWarden.Infrastructure.Data
@{
    ViewData["Title"] = "Admin";
    var r = Model.Report;
}
<div class="page-head"><div><h1>Admin</h1><p class="lead">How this RecipeWarden is doing.</p></div></div>
@if (Model.PromptTwoFactor)
{
    <div class="notice" role="note"><p><strong>Protect your Admin account:</strong> turn on <a href="/account/2fa">two-factor sign-in</a>, so a password alone cannot open it.</p></div>
}
<div class="dashboard">
    <section aria-labelledby="d-health">
        <h2 id="d-health" class="card-title"><partial name="_Icon" model="@("health")" />Health</h2>
        <p class="@RecipeWarden.Web.Pages.Admin.HealthModel.CssStatus(r.Status)"><strong>@r.Status</strong></p>
        @foreach (var c in r.Checks.Where(c => c.Status != HealthStatus.OK)) { <p>@c.Name: @c.Message</p> }
        @foreach (var v in r.Volumes) { <p>@v.Label: @HealthRules.FormatBytes(v.FreeBytes) free of @HealthRules.FormatBytes(v.TotalBytes)</p> }
    </section>
    <section aria-labelledby="d-backup">
        <h2 id="d-backup" class="card-title"><partial name="_Icon" model="@("backup")" />Backups</h2>
        @if (Model.LastBackup is { } b)
        {
            <p>Last run @b.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"): <strong>@(b.Status == BackupStatus.Succeeded ? "succeeded" : "FAILED")</strong>@(b.Error is null ? "" : " — " + b.Error)</p>
        }
        else
        {
            <p>No backups yet.</p>
        }
        <p>Next scheduled: @(Model.NextScheduled?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "no schedule")</p>
        <p>@(Model.Encrypted ? "Backups are encrypted." : "Backups are not encrypted yet.")</p>
    </section>
    <section aria-labelledby="d-ai">
        <h2 id="d-ai" class="card-title"><partial name="_Icon" model="@("ai")" />AI parser</h2>
        <p>@(Model.Ai.Enabled ? "On" : "Off")@(Model.Ai.Enabled ? ", " + Model.AiUsage.Total.ToString("N0") + " tokens this month" + (Model.AiUsage.Cap is { } cap ? " of " + cap.ToString("N0") : "") : "")</p>
    </section>
    <section aria-labelledby="d-version">
        <h2 id="d-version" class="card-title"><partial name="_Icon" model="@("settings")" />Version</h2>
        <p>RecipeWarden @RecipeWarden.Web.Hosting.AppInfo.Version</p>
        <p>Database @r.Database.SchemaVersion</p>
    </section>
</div>
<section class="card" aria-labelledby="recent-heading">
<h2 id="recent-heading">Recent changes</h2>
@if (Model.Recent.Count == 0)
{
    <p class="empty-state">Nothing yet.</p>
}
else
{
    <ul class="recent-audit">
        @foreach (var e in Model.Recent) { <li><time datetime="@e.At.ToString("O")">@e.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time> @e.UserName — @e.Action @e.EntityId</li> }
    </ul>
    <p><a href="/admin/audit">Full audit log</a></p>
}
</section>
