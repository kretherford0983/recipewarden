@page "/manage/trash"
@model RecipeWarden.Web.Pages.Manage.TrashModel
@{
    ViewData["Title"] = "Trash";
}
<h1>Trash</h1>
<p>Recipes here can be restored for 30 days; after that they are deleted for good.</p>
@if (Model.Message is not null)
{
    <div class="notice" role="status">
        <p>@Model.Message</p>
        @if (Model.UndoId is int undo)
        {
            <form method="post" action="/manage/trash?handler=Restore" asp-antiforgery="true">
                <input type="hidden" name="id" value="@undo">
                <button type="submit">Undo</button>
            </form>
        }
    </div>
}
@if (Model.Items.Count == 0)
{
    <p class="empty-state">The trash is empty.</p>
}
else
{
    <table class="list">
        <thead><tr><th scope="col">Recipe</th><th scope="col">Deleted</th><th scope="col">Deleted for good on</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Title</td>
                <td><time datetime="@item.DeletedAt.ToString("O")">@item.DeletedAt.ToString("yyyy-MM-dd")</time></td>
                <td><time datetime="@item.PurgesOn.ToString("O")">@item.PurgesOn.ToString("yyyy-MM-dd")</time></td>
                <td class="actions">
                    <form method="post" action="/manage/trash?handler=Restore" asp-antiforgery="true">
                        <input type="hidden" name="id" value="@item.Id">
                        <button type="submit">Restore</button>
                    </form>
                    @if (Model.IsAdmin)
                    {
                        <details class="confirm">
                            <summary>Delete for good…</summary>
                            <form method="post" action="/manage/trash?handler=Purge" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@item.Id">
                                <p>This cannot be undone.</p>
                                <button type="submit" class="danger">Delete “@item.Title” for good</button>
                            </form>
                        </details>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
