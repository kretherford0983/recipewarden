@page "/manage/nutrition"
@model RecipeWarden.Web.Pages.Manage.NutritionModel
@using RecipeWarden.Core.Nutrition
@{
    ViewData["Title"] = "Nutrition data";
}
<h1>Nutrition data</h1>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
@if (Model.Error is not null) { <p class="notice error" role="alert">@Model.Error</p> }
@if (Model.Dataset is { } ds)
{
    <p class="hint">USDA FoodData Central (CC0): @ds.Text, @ds.Foods.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) foods. Nothing is looked up online.</p>
}

<section aria-labelledby="unmatched-heading">
    <h2 id="unmatched-heading">Unmatched ingredients</h2>
    @if (Model.Report.Count == 0)
    {
        <p>Every ingredient with an amount has nutrition data.</p>
    }
    else
    {
        <p class="hint">Most used first. Mapping one fixes it in every recipe.</p>
        <table class="list">
            <thead><tr><th scope="col">Ingredient</th><th scope="col">Recipes</th><th scope="col">Why</th><th scope="col"></th></tr></thead>
            <tbody>
                @foreach (var row in Model.Report)
                {
                    <tr>
                        <td>@row.Name</td>
                        <td>@row.Recipes</td>
                        <td>@row.Reason</td>
                        <td><a href="/manage/nutrition?map=@Uri.EscapeDataString(row.Name)@(row.FoodId is { } f ? "&food=" + f : "")#map">Map</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section aria-labelledby="map-heading" id="map">
    <h2 id="map-heading">@(Model.MapName is null ? "Find a food" : "Map “" + Model.MapName + "”")</h2>
    <form method="get" action="/manage/nutrition#map" class="inline-form">
        @if (Model.MapName is not null) { <input type="hidden" name="map" value="@Model.MapName"> }
        @if (Model.MapFood is { } mf) { <input type="hidden" name="food" value="@mf"> }
        <label for="nutrient-q">Search the food data</label>
        <input id="nutrient-q" name="q" value="@(Model.Query ?? Model.MapName)" placeholder="e.g. chili paste" maxlength="100">
        <button type="submit">Search</button>
    </form>
    @if (Model.AiEnabled && Model.MapName is not null)
    {
        <form method="post" action="/manage/nutrition?handler=Suggest#map" asp-antiforgery="true" class="inline-form">
            <input type="hidden" name="name" value="@Model.MapName">
            @if (Model.MapFood is { } sf) { <input type="hidden" name="foodId" value="@sf"> }
            <button type="submit">Suggest a match with AI</button>
        </form>
    }
    @if (Model.Suggestion is { } s && Model.MapName is not null)
    {
        <div class="notice ai-suggestion" role="status">
            <p><span class="badge ai">AI</span> Suggested: <strong>@s.Description</strong> (@NutritionRules.Format(s.Calories) kcal per 100 g)</p>
            <form method="post" action="/manage/nutrition?handler=Map" asp-antiforgery="true">
                <input type="hidden" name="name" value="@Model.MapName">
                @if (Model.MapFood is { } food2) { <input type="hidden" name="foodId" value="@food2"> }
                <input type="hidden" name="nutrientId" value="@s.Id">
                <button type="submit">Use this suggestion</button>
            </form>
        </div>
    }
    @if (Model.Choices.Count > 0)
    {
        <table class="list">
            <thead><tr><th scope="col">Food</th><th scope="col">Per 100 g</th><th scope="col"></th></tr></thead>
            <tbody>
                @foreach (var c in Model.Choices)
                {
                    <tr id="label-@c.Id">
                        <td>@c.Description @if (c.Source == "Custom") { <span class="badge">custom</span> } @if (c.Removed) { <span class="badge partial">not in current data</span> }<br><span class="hint">@c.Category@(c.Dataset is { } set ? (c.Category is null ? "" : " · ") + set : "")</span></td>
                        <td>@NutritionRules.Format(c.Calories) kcal</td>
                        <td>
                            @if (Model.MapName is not null)
                            {
                                <form method="post" action="/manage/nutrition?handler=Map" asp-antiforgery="true">
                                    <input type="hidden" name="name" value="@Model.MapName">
                                    @if (Model.MapFood is { } food) { <input type="hidden" name="foodId" value="@food"> }
                                    <input type="hidden" name="nutrientId" value="@c.Id">
                                    <button type="submit" aria-label="Use @c.Description for @Model.MapName">Use this</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if ((Model.Query ?? Model.MapName) is not null)
    {
        <p>No foods match. Try fewer words, or add it from its label below.</p>
    }
</section>

<section aria-labelledby="label-heading">
    <h2 id="label-heading">Add a food from a package label</h2>
    <p class="hint">Copy the Nutrition Facts for one serving; it is stored per 100 g (FR-NUT-04).</p>
    <form method="post" action="/manage/nutrition?handler=Label" class="nutrition-form" asp-antiforgery="true">
        <label for="label-name">Food name</label>
        <input id="label-name" name="labelName" required maxlength="100" placeholder="e.g. Gochujang (brand)">
        <label for="label-serving">Serving size</label>
        <input id="label-serving" name="serving" required inputmode="decimal" size="6">
        <label for="label-unit" class="visually-hidden">Serving unit</label>
        <select id="label-unit" name="servingUnit"><option value="g">g</option><option value="ml">ml</option></select>
        <label for="label-density">Density (g/ml, for ml servings; optional)</label>
        <input id="label-density" name="density" inputmode="decimal" size="6">
        @foreach (var (name, label) in new[] { ("Calories", "Calories"), ("FatG", "Fat (g)"), ("SatFatG", "Saturated fat (g)"), ("CholesterolMg", "Cholesterol (mg)"), ("SodiumMg", "Sodium (mg)"), ("CarbsG", "Carbohydrate (g)"), ("FiberG", "Fibre (g)"), ("SugarG", "Sugar (g)"), ("ProteinG", "Protein (g)") })
        {
            <label for="label-@name">@label</label>
            <input id="label-@name" name="Label.@name" value="@Model.Label.Get(name)" inputmode="decimal" size="6">
        }
        <p><button type="submit" class="primary">Add food</button></p>
    </form>
</section>
