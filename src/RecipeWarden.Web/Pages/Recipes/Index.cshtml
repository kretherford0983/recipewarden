@page "/recipes"
@model RecipeWarden.Web.Pages.Recipes.IndexModel
@{
    ViewData["Title"] = Model.ShowingDrafts ? "Drafts" : "Browse";
}
<h1>@(Model.ShowingDrafts ? "Drafts" : "Browse recipes")</h1>
<p class="toolbar recipe-actions">
    @* FR-EXP-03, FR-EXP-04 (ADR 0031, 0033) *@
    <a class="button-link" href="/recipes/export.zip" download>Download all (Markdown + images)</a>
    <a class="button-link" href="/recipes/export-ai">Export all for AI</a>
</p>
@if (Model.CanEdit)
{
    <p class="toolbar">
        <a class="button-link" href="/manage/recipes/new">New recipe</a>
        @if (Model.ShowingDrafts) { <a href="/recipes">Show published</a> } else { <a href="/recipes?status=draft">Show drafts</a> }
    </p>
}
<partial name="_RecipeList" model="Model" />
