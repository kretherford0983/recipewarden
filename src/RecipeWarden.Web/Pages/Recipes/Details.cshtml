@page "/recipes/{slug}"
@model RecipeWarden.Web.Pages.Recipes.DetailsModel
@using RecipeWarden.Core.Measurement
@using RecipeWarden.Core.Recipes
@using RecipeWarden.Infrastructure.Measurement
@using RecipeWarden.Web.Content
@{
    var r = Model.Recipe!;
    var sc = Model.Scaled!;
    var scalable = sc.Ingredients.SelectMany(g => g.Lines).Where(l => l.CanScaleFrom).ToList();
    var containers = Model.Containers?.Containers ?? (IReadOnlyList<RecipeWarden.Core.Kitchen.KitchenToolInfo>)[];
    var unitsForYield = r.YieldUnitCode is { } yc ? UnitCatalog.FindByCode(yc) : null;
    var yieldNow = r.YieldAmount is { } ya && unitsForYield is not null ? AmountText.Format(ya, unitsForYield) : null;
    var yieldShown = Model.Containers?.Yield is { } fy
        ? (fy.IsEstimate ? "about " : "") + AmountText.Format(fy.Ml / UnitCatalog.FindByCode("floz")!.ToBase, UnitCatalog.FindByCode("floz")!)
        : "";
    ViewData["Title"] = r.Title;
}
<article class="recipe" aria-labelledby="recipe-title">
    <p class="breadcrumb"><a href="/recipes">Browse</a> ›</p>
    @if (r.Status == RecipeStatus.Draft)
    {
        <p class="notice" role="status">Draft — only editors can see this recipe until it is published.</p>
    }
    <header class="recipe-header">
        <h1 id="recipe-title">@r.Title</h1>
        @if (r.Tags.Count > 0)
        {
            <ul class="tags" aria-label="Tags">
                @foreach (var t in r.Tags) { <li><a href="/tags/@t.Slug">@t.Name</a></li> }
            </ul>
        }
        @if (Model.CanEdit)
        {
            <p class="toolbar"><a class="button-link" href="/manage/recipes/@r.Id/edit">Edit</a></p>
        }
    </header>

    @if (Model.ImageCopyFailed)
    {
        <p class="notice" role="status">@RecipeWarden.Infrastructure.Import.ImportService.ImageNotCopied. You can add a photo on the edit page.</p>
    }
    @if (r.FinishImageId is not null)
    {
        <img class="finish-image" src="/media/@r.FinishImageId" alt="@r.Title">
    }

    <section class="recipe-meta" aria-label="About this recipe">
        @if (r.Description is not null)
        {
            <div class="prose">@MarkdownRenderer.Render(r.Description)</div>
        }
        <dl class="facts">
            <dt>Servings</dt>
            <dd>@ServingsRules.Format(r.Servings, r.ServingsMax)@(r.ServingsEstimated ? " (estimated)" : "")</dd>
            @if (r.PrepMinutes is not null) { <dt>Prep</dt><dd>@TimeText.Format(r.PrepMinutes, r.PrepMinutesMax)</dd> }
            @if (r.CookMinutes is not null) { <dt>Cook</dt><dd>@TimeText.Format(r.CookMinutes, r.CookMinutesMax)</dd> }
            @if (r.TotalMinutes is not null) { <dt>Total</dt><dd>@TimeText.Format(r.TotalMinutes, r.TotalMinutesMax)</dd> }
            @if (r.IsPrecision) { <dt>Type</dt><dd>Baking / precision</dd> }
        </dl>
        @if (r.SourceName is not null || r.SourceUrl is not null)
        {
            @* BR-10: credit and link cannot be hidden. Source URLs are http(s) only (SourceRules). *@
            <p class="source-credit">
                Source:
                @if (r.SourceUrl is not null)
                {
                    <a href="@r.SourceUrl" rel="noopener noreferrer nofollow">@(r.SourceName ?? r.SourceUrl)</a>
                }
                else
                {
                    <span>@r.SourceName</span>
                }
                @if (r.SourceAuthor is not null) { <span> by @r.SourceAuthor</span> }
            </p>
        }
    </section>

    <div id="recipe-body" class="recipe-body">
        @* FR-SCL-01/02, FR-UI-02, 7.3 item 3, ADR 0014: plain GET forms; htmx swaps this block and updates the URL. *@
        <section class="scale-toolbar" aria-label="Scale and units">
            <form method="get" action="/recipes/@r.Slug" class="scale-presets" hx-get="/recipes/@r.Slug" hx-target="#recipe-body"
                  hx-select="#recipe-body" hx-swap="outerHTML" hx-push-url="true">
                <input type="hidden" name="units" value="@DisplayUnitsRules.ToValue(sc.Units)">
                <span class="toolbar-label" id="scale-label">Scale</span>
                <span role="group" aria-labelledby="scale-label">
                    @foreach (var p in ScaleRules.Presets)
                    {
                        <button type="submit" name="scale" value="@ScaleRules.ToQuery(p)" aria-pressed="@(sc.Factor == p ? "true" : "false")">@ScaleRules.Label(p)</button>
                    }
                </span>
            </form>
            <form method="get" action="/recipes/@r.Slug" class="inline-form" hx-get="/recipes/@r.Slug" hx-target="#recipe-body"
                  hx-select="#recipe-body" hx-swap="outerHTML" hx-push-url="true">
                <input type="hidden" name="units" value="@DisplayUnitsRules.ToValue(sc.Units)">
                <label for="custom-scale">Custom</label>
                <input id="custom-scale" name="scale" inputmode="decimal" size="5" maxlength="@ScaleRules.MaxTextLength"
                       placeholder="e.g. 2.5" value="@(sc.Factor != 1m && !ScaleRules.Presets.Contains(sc.Factor) ? DetailsModel.Number(sc.Factor) : null)">
                <button type="submit">Scale</button>
            </form>
            <form method="get" action="/recipes/@r.Slug" class="inline-form" hx-get="/recipes/@r.Slug" hx-target="#recipe-body"
                  hx-select="#recipe-body" hx-swap="outerHTML" hx-push-url="true">
                <input type="hidden" name="units" value="@DisplayUnitsRules.ToValue(sc.Units)">
                <label for="target-servings">Servings</label>
                <input id="target-servings" name="servings" inputmode="decimal" size="4" maxlength="@ScaleRules.MaxTextLength"
                       value="@(Model.TargetServings is { } ts ? DetailsModel.Number(ts) : null)">
                <button type="submit">Set</button>
            </form>
            <form method="get" action="/recipes/@r.Slug" class="inline-form" hx-get="/recipes/@r.Slug" hx-target="#recipe-body"
                  hx-select="#recipe-body" hx-swap="outerHTML" hx-push-url="true" hx-trigger="change, submit">
                @if (sc.Factor != 1m) { <input type="hidden" name="scale" value="@ScaleRules.ToQuery(sc.Factor)"> }
                <label for="units">Units</label>
                <select id="units" name="units">
                    @foreach (var u in Enum.GetValues<DisplayUnits>())
                    {
                        <option value="@DisplayUnitsRules.ToValue(u)" selected="@(u == sc.Units)">@DisplayUnitsRules.Label(u)</option>
                    }
                </select>
                <button type="submit" class="no-js-only">Show</button>
            </form>
            @if (scalable.Count > 0)
            {
                <details class="scale-from" open="@(Model.ScaleSource?.StartsWith("from", StringComparison.Ordinal) == true || Model.ScaleMessage is not null && Request.Query.ContainsKey("from"))">
                    <summary>Scale from what I have</summary>
                    <form method="get" action="/recipes/@r.Slug" class="inline-form" hx-get="/recipes/@r.Slug" hx-target="#recipe-body"
                          hx-select="#recipe-body" hx-swap="outerHTML" hx-push-url="true">
                        <input type="hidden" name="units" value="@DisplayUnitsRules.ToValue(sc.Units)">
                        <label for="have-amount">I have</label>
                        <input id="have-amount" name="have" size="8" maxlength="@RecipeScaler.MaxHaveLength" placeholder="3 lb" required
                               value="@Request.Query["have"]">
                        <label for="have-line">of</label>
                        <select id="have-line" name="from">
                            @foreach (var l in scalable)
                            {
                                <option value="@l.Index" selected="@(Request.Query["from"] == l.Index.ToString(System.Globalization.CultureInfo.InvariantCulture))">@l.RawText</option>
                            }
                        </select>
                        <button type="submit">Scale</button>
                    </form>
                </details>
            }
            <details class="fit-container" open="@Model.FitRequested">
                <summary>Fit to container</summary>
                @* FR-SCL-04/05, ADR 0019: a GET like any scale (BR-114); the yield typed here is not saved. *@
                <form method="get" action="/recipes/@r.Slug" class="inline-form" hx-get="/recipes/@r.Slug" hx-target="#recipe-body"
                      hx-select="#recipe-body" hx-swap="outerHTML" hx-push-url="true">
                    <input type="hidden" name="units" value="@DisplayUnitsRules.ToValue(sc.Units)">
                    @if (containers.Count > 0)
                    {
                        <label for="fit-tool">Container</label>
                        <select id="fit-tool" name="fit">
                            <option value="">Type a capacity →</option>
                            @foreach (var c in containers)
                            {
                                <option value="@c.Id" selected="@(Model.FitToolId == c.Id)">@c.Name</option>
                            }
                        </select>
                    }
                    <label for="fit-capacity">Capacity</label>
                    <input id="fit-capacity" name="capacity" size="8" maxlength="40" placeholder="16 fl oz" value="@Model.FitCapacity">
                    <label for="fit-count">How many</label>
                    <input id="fit-count" name="count" type="number" min="1" max="20" value="@(Model.FitCount ?? 1)">
                    <label for="fit-fill">Fill %</label>
                    <input id="fit-fill" name="fill" size="4" inputmode="decimal" placeholder="90" value="@Model.FitFill">
                    <label for="fit-yield">It makes</label>
                    <input id="fit-yield" name="yield" size="8" maxlength="40" value="@Model.TypedYield"
                           placeholder="@(yieldNow ?? "e.g. 12 fl oz")">
                    <button type="submit">Fit</button>
                </form>
                @if (containers.Count > 0)
                {
                    <form method="get" action="/recipes/@r.Slug" class="inline-form" hx-get="/recipes/@r.Slug" hx-target="#recipe-body"
                          hx-select="#recipe-body" hx-swap="outerHTML" hx-push-url="true">
                        @if (sc.Factor != 1m && !Model.FitRequested) { <input type="hidden" name="scale" value="@ScaleRules.ToQuery(sc.Factor)"> }
                        <input type="hidden" name="units" value="@DisplayUnitsRules.ToValue(sc.Units)">
                        <label for="howmany">How many</label>
                        <select id="howmany" name="howmany">
                            @foreach (var c in containers) { <option value="@c.Id" selected="@(Model.HowManyToolId == c.Id)">@c.Name</option> }
                        </select>
                        <span>will this make?</span>
                        <button type="submit">Show</button>
                    </form>
                }
            </details>
            @if (Model.CanEdit)
            {
                <a class="button-link" href="/manage/recipes/@r.Id/cooked">I made this</a>
            }
            <button type="button" class="save-default" hidden data-units="@DisplayUnitsRules.ToValue(sc.Units)"
                    data-scale="@ScaleRules.ToQuery(sc.Factor)" data-signed-in="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
                Make this my default
            </button>
        </section>

        <div class="scale-status" role="status" aria-live="polite">
            @if (Model.ScaleMessage is not null) { <p class="notice">@Model.ScaleMessage</p> }
            @if (sc.Factor != 1m)
            {
                <p class="scaled-note">
                    Scaled @ScaleRules.Label(sc.Factor)@(Model.ScaleSource is null ? "" : " (" + Model.ScaleSource + ")"):
                    serves @ServingsRules.Format(sc.Servings, sc.ServingsMax).
                    The saved recipe is unchanged. <a href="@Model.Link(1m, DisplayUnits.AsWritten)">Show as written</a>
                </p>
            }
            @if (sc.TimeNote is not null) { <p class="notice">@sc.TimeNote</p> }
            @if (Model.JustCooked) { <p class="notice">Saved: marked as made today.</p> }
            @if (sc.AssumedToolsNote is not null) { <p class="hint">@sc.AssumedToolsNote</p> }
            @if (Model.FitMessage is not null) { <p class="notice">@Model.FitMessage</p> }
            @if (Model.Fit?.Fill is { } fill)
            {
                <p class="scaled-note">
                    Makes @(yieldShown) → @fill.
                    @if (Model.Containers?.Yield is { IsEstimate: true } est)
                    {
                        <span>(The yield is an estimate@(est.Excluded.Count > 0 ? "; not counted: " + string.Join(", ", est.Excluded) : "").)</span>
                    }
                </p>
                @if (Model.Fit.Note is not null) { <p class="notice">@Model.Fit.Note</p> }
                @if (sc.RoundingWarning is not null) { <p class="notice">@sc.RoundingWarning</p> }
            }
            @if (Model.HowMany is { Length: > 0 } howMany) { <p class="scaled-note">This makes @howMany.</p> }
            @if (Model.HowManyToolId is not null && Model.HowMany is null && Model.Containers?.Error is { } howError) { <p class="notice">@howError</p> }
        </div>

        @{ var viewQuery = Model.ViewQuery(); }
        <nav class="recipe-actions" aria-label="Print, cook and export">
            @* ADR 0031: each takes this view's scale, units and weights. *@
            <a class="button-link" href="/recipes/@r.Slug/cook@(viewQuery)">Cook mode</a>
            <a class="button-link" href="/recipes/@r.Slug/print@(viewQuery)">Print</a>
            <a class="button-link" href="/recipes/@r.Slug/export.md@(viewQuery)" download>Markdown</a>
            <a class="button-link" href="/recipes/@r.Slug/export.zip@(viewQuery)" download>Markdown + images</a>
            <a class="button-link" href="/recipes/@r.Slug/export-ai">Export for AI</a>
            @if (Model.CanEdit) { <a class="button-link" href="/manage/import/ai-response?parent=@r.Slug">Import AI response</a> }
        </nav>
        @if (Model.CanEdit)
        {
            @* FR-SHOP-01: adds the recipe at the scale shown. *@
            <form class="inline-form add-to-list" method="post" action="/shopping/new?handler=AddRecipe" asp-antiforgery="true">
                <input type="hidden" name="slug" value="@r.Slug">
                <input type="hidden" name="scale" value="@ScaleRules.ToQuery(sc.Factor)">
                <label for="shopping-list">Add to shopping list</label>
                <select id="shopping-list" name="listId">
                    @foreach (var l in Model.ShoppingLists) { <option value="@l.Id">@l.Name</option> }
                    <option value="">New list…</option>
                </select>
                <label for="new-list-name" class="visually-hidden">New list name</label>
                <input id="new-list-name" name="newName" maxlength="@RecipeWarden.Core.Shopping.ShoppingRules.MaxListNameLength" placeholder="New list name">
                <button type="submit">Add@(sc.Factor != 1m ? " at " + ScaleRules.Label(sc.Factor) : "")</button>
            </form>
            @if (Model.AddedList is { } added)
            {
                <p class="notice" role="status">Added to <a href="/shopping/@added.Id">@added.Name</a>.</p>
            }
        }

        @foreach (var offer in sc.Suggestions)
        {
            @* FR-TOOL-04, ADR 0017: worked out on this view; nothing is saved by reading it. *@
            <section class="suggestion-banner" role="region" aria-label="Suggestion">
                <p>@offer.Message</p>
                <ul>@foreach (var l in offer.Lines) { <li>@l.Before → @l.After</li> }</ul>
                <a class="button-link" href="@Model.ShowMeLink()">Show me</a>
                @if (Model.CanEdit)
                {
                    @await Html.PartialAsync("/Pages/Manage/Recipes/_SuggestionActions.cshtml", (r.Id, offer.Key))
                }
            </section>
        }
        @if (sc.ShowingWeights)
        {
            <p class="notice">Showing weights for this view. @(Model.CanEdit ? "Save to recipe to keep them." : "")</p>
        }

        @if (sc.Pan is { } pan && sc.PanOptions.Count > 0)
        {
            @* FR-MEAS-07, ADR 0020 *@
            <section class="pan-options" aria-label="Pan sizes">
                <p>Pan: @RecipeWarden.Core.Kitchen.PanRules.Describe(pan)@(sc.PanFromSteps ? " (from the steps)" : ""). At @ScaleRules.Label(sc.Factor), these hold about the same:</p>
                <ul>@foreach (var o in sc.PanOptions) { <li>@o.Text</li> }</ul>
            </section>
        }

        <div class="recipe-columns">
            <section class="ingredients" aria-labelledby="ingredients-heading">
                <h2 id="ingredients-heading">Ingredients</h2>
                @foreach (var g in sc.Ingredients)
                {
                    @if (g.Name is not null) { <h3>@g.Name</h3> }
                    <ul>
                        @foreach (var line in g.Lines)
                        {
                            <li class="@(line.Changed ? "converted" : null)" title="@(line.Changed ? "Written: " + line.RawText + (line.Explanation is null ? "" : ". " + line.Explanation) : null)">
                                @line.Text
                                @if (line.NeedsReview && Model.CanEdit)
                                {
                                    <span class="badge warn" title="The parser was unsure about this line; check it in the editor">check</span>
                                }
                                @if (line.Secondary is not null) { <span class="secondary">(@line.Secondary)</span> }
                                @if (line.Hint is not null) { <span class="hint">@line.Hint</span> }
                                @if (line.YieldNote is not null) { <p class="smart-note">@line.YieldNote</p> }
                            </li>
                        }
                    </ul>
                }
            </section>
            <section class="steps" aria-labelledby="steps-heading">
                <h2 id="steps-heading">Steps</h2>
                @foreach (var s in sc.Steps)
                {
                    @if (s.Name is not null) { <h3>@s.Name</h3> }
                    <ol>
                        @foreach (var step in s.Steps)
                        {
                            <li>
                                @if (step.Title is not null) { <strong class="step-title">@step.Title</strong> }
                                @step.Text
                                @if (step.ImageId is not null) { <img class="step-image" src="/media/@step.ImageId" alt="" loading="lazy"> }
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>
    </div>

    @if (r.Notes is not null)
    {
        <section class="notes" aria-labelledby="notes-heading">
            <h2 id="notes-heading">Notes</h2>
            <div class="prose">@MarkdownRenderer.Render(r.Notes)</div>
        </section>
    }

    @if (r.Parent is { } parent)
    {
        <p class="variant-of">Variant of <a href="/recipes/@parent.Slug">@parent.Title</a></p>
    }
    @if (r.Variants.Count > 0)
    {
        <p class="variants">Variants:
            @for (var i = 0; i < r.Variants.Count; i++)
            {
                <a href="/recipes/@r.Variants[i].Slug">@r.Variants[i].Title</a>@(i < r.Variants.Count - 1 ? ", " : "")
            }
        </p>
    }

    @if (r.Collections.Count > 0)
    {
        <p class="in-collections">In:
            @for (var i = 0; i < r.Collections.Count; i++)
            {
                <a href="/collections/@r.Collections[i].Slug">@r.Collections[i].Name</a>@(i < r.Collections.Count - 1 ? ", " : "")
            }
        </p>
    }

    @if (Model.CanEdit && Model.AvailableCollections.Count > 0)
    {
        <form class="inline-form" method="post" action="/manage/collections?handler=AddRecipe" asp-antiforgery="true">
            <input type="hidden" name="recipeId" value="@r.Id">
            <input type="hidden" name="returnSlug" value="@r.Slug">
            <label for="add-to-collection">Add to collection</label>
            <select id="add-to-collection" name="collectionId">
                @foreach (var c in Model.AvailableCollections) { <option value="@c.Id">@c.Name</option> }
            </select>
            <button type="submit">Add</button>
        </form>
    }
</article>
<script src="~/js/recipe.js" asp-append-version="true" defer></script>
