@page
@model IndexModel
@using RecipeWarden.Infrastructure.Recipes
@{
    ViewData["Title"] = "Home";
}
<section class="home-hero recipe-row" aria-label="Search">
    <h1>What are we cooking?</h1>
    <form class="home-search" role="search" method="get" action="/search">
        <label for="home-q" class="visually-hidden">Search recipes</label>
        <input id="home-q" name="q" type="search" placeholder="Search recipes, ingredients, tags…">
        <button type="submit" class="primary">Search</button>
    </form>
</section>

@if (Model.Recent.Count == 0)
{
    <section class="empty-state">
        <p>No recipes yet.</p>
        @if (Model.CanEdit)
        {
            <p><a class="button-link primary" href="/manage/recipes/new">Add one</a> <a class="button-link" href="/manage/import">Import</a></p>
        }
    </section>
}
else
{
    @await Html.PartialAsync("_RecommendationRow", ("season-heading", "In season", Model.Picks.InSeason))
    @await Html.PartialAsync("_RecommendationRow", ("favorites-heading", "Favorites", Model.Picks.Favorites))
    @await Html.PartialAsync("_RecommendationRow", ("lately-heading", "Not cooked lately", Model.Picks.NotCookedLately))
    <section class="recipe-row" aria-labelledby="recent-heading">
        <div class="section-head">
            <h2 id="recent-heading">Recently added</h2>
            <a href="/recipes">Browse all recipes →</a>
        </div>
        <ul class="recipe-grid">
            @foreach (var r in Model.Recent)
            {
                <partial name="_RecipeCard" model="@((r, 3))" />
            }
        </ul>
    </section>
}

@if (Model.Collections.Count > 0)
{
    <section class="recipe-row" aria-labelledby="collections-heading">
        <div class="section-head">
            <h2 id="collections-heading">Collections</h2>
            <a href="/collections">All collections →</a>
        </div>
        <ul class="collection-list">
            @foreach (var c in Model.Collections)
            {
                <li>
                    <a class="tile" href="/collections/@c.Slug">
                        <span class="tile-icon"><partial name="_Icon" model="@("collections")" /></span>
                        <span><span class="tile-title">@c.Name</span></span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@if (Model.Tags.Count > 0)
{
    <section class="recipe-row" aria-labelledby="tags-heading">
        <h2 id="tags-heading">Browse by tag</h2>
        <ul class="tags">
            @foreach (var t in Model.Tags) { <li><a href="/tags/@t.Slug">@t.Name</a></li> }
        </ul>
    </section>
}
