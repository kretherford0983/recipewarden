@model (string Id, string Heading, IReadOnlyList<RecipeWarden.Infrastructure.Recipes.RecipeCard> Cards)
@* FR-HOME-02, UX-09: a recommendation row; not rendered when empty. *@
@if (Model.Cards.Count > 0)
{
    <section aria-labelledby="@Model.Id">
        <h2 id="@Model.Id">@Model.Heading</h2>
        <ul class="recipe-grid">
            @foreach (var r in Model.Cards)
            {
                <li class="recipe-card">
                    @if (r.ImageId is not null) { <img class="thumb" src="/media/@r.ImageId/thumb" alt="" loading="lazy"> }
                    <a href="/recipes/@r.Slug"><h3>@r.Title</h3></a>
                    @if (r.Summary is not null) { <p>@r.Summary</p> }
                    @if (r.TotalMinutes is not null) { <p class="meta">@r.TimeText</p> }
                </li>
            }
        </ul>
    </section>
}
