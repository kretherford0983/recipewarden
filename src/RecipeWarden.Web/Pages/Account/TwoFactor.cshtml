@page "/account/2fa"
@model RecipeWarden.Web.Pages.Account.TwoFactorModel
@{
    ViewData["Title"] = "Two-factor sign-in";
}
<h1>Two-factor sign-in</h1>
@if (Model.Message is not null) { <div class="notice" role="status"><p>@Model.Message</p></div> }
@if (Model.Error is not null) { <div class="form-errors" role="alert"><p>@Model.Error</p></div> }

@if (Model.RecoveryCodes.Count > 0)
{
    <section class="recovery-codes" aria-labelledby="codes-h">
        <h2 id="codes-h">Recovery codes</h2>
        <p>Keep these somewhere safe (a password manager or printed). If you lose your phone, each one signs you in once.</p>
        <ul class="codes">@foreach (var c in Model.RecoveryCodes) { <li><code>@c</code></li> }</ul>
    </section>
}

@if (Model.Enabled)
{
    <p><strong>On.</strong> Signing in asks for a code from your authenticator app. Recovery codes left: @Model.RecoveryCodesLeft.</p>
    <form method="post" action="/account/2fa?handler=RecoveryCodes" asp-antiforgery="true">
        <button type="submit">Make new recovery codes</button>
    </form>
    <details class="confirm">
        <summary>Turn two-factor sign-in off…</summary>
        <form method="post" action="/account/2fa?handler=Disable" asp-antiforgery="true" class="form narrow">
            <div class="field"><label for="off-code">Current code from your authenticator app</label><input id="off-code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="9" required></div>
            <button type="submit" class="danger">Turn off</button>
        </form>
    </details>
}
else if (Model.SharedKey is not null)
{
    <ol class="steps">
        <li>In an authenticator app (e.g. 2FAS, Aegis, Google Authenticator, 1Password), add an account by scanning this code:
            <p><img src="@Model.QrDataUri" alt="QR code for your authenticator app (the key is also written below)" width="232" height="232"></p>
            or type this key: <code class="key">@Model.SharedKey</code></li>
        <li>Enter the 6-digit code the app shows:
            <form method="post" action="/account/2fa?handler=Confirm" asp-antiforgery="true" class="form narrow">
                <div class="field"><label for="confirm-code">Code</label><input id="confirm-code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="9" required></div>
                <button type="submit" class="primary">Turn on</button>
            </form>
        </li>
    </ol>
}
else
{
    <p><strong>Off.</strong> With two-factor sign-in, your password alone is not enough to sign in: you also enter a code from an app on your phone.
        Admins especially should turn it on.</p>
    <form method="post" action="/account/2fa?handler=Start" asp-antiforgery="true">
        <button type="submit" class="primary">Set up two-factor sign-in</button>
    </form>
}
<p><a href="/account/password">Change password</a></p>
