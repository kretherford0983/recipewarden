@page "/account/login"
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-page">
<div class="card">
    <div class="auth-logo"><span class="logo"><partial name="_Icon" model="@("logo")" /></span></div>
    <h1>Sign in</h1>
@if (Model.Notice is not null)
{
    <div class="notice" role="status"><p>@Model.Notice</p></div>
}
<form method="post" class="form" novalidate asp-antiforgery="true">
    @if (Model.ErrorMessage is not null)
    {
        <div class="form-errors" role="alert">@Model.ErrorMessage</div>
    }
    <input type="hidden" asp-for="ReturnUrl">
    <div class="field">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" autocomplete="username" required>
    </div>
    <div class="field">
        <label asp-for="Input.Password">Password</label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" required>
    </div>
    <div class="field checkbox">
        <label><input type="checkbox" name="Input.RememberMe" value="true"> Keep me signed in on this device (30 days)</label>
    </div>
    <button type="submit" class="primary">Sign in</button>
</form>
</div>
</div>
