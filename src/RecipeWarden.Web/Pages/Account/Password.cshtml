@page "/account/password"
@model RecipeWarden.Web.Pages.Account.PasswordModel
@using RecipeWarden.Core.Security
@{
    ViewData["Title"] = "Change password";
}
<h1>Change password</h1>
@if (Model.Message is not null) { <div class="notice" role="status"><p>@Model.Message</p></div> }
@if (Model.Errors.Count > 0) { <div class="form-errors" role="alert"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div> }
<form method="post" action="/account/password" asp-antiforgery="true" class="form narrow">
    <div class="field"><label for="pw-current">Current password</label><input id="pw-current" name="current" type="password" autocomplete="current-password" required></div>
    <div class="field"><label for="pw-new">New password (at least @AccountRules.MinimumPasswordLength characters; a few unrelated words work well)</label>
        <input id="pw-new" name="password" type="password" autocomplete="new-password" minlength="@AccountRules.MinimumPasswordLength" required></div>
    <div class="field"><label for="pw-confirm">New password again</label><input id="pw-confirm" name="confirm" type="password" autocomplete="new-password" required></div>
    <button type="submit" class="primary">Change password</button>
</form>
<p><a href="/account/2fa">Two-factor sign-in</a></p>
